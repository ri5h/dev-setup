#!/usr/bin/env bash

set -euo pipefail

BREW_BIN="/home/linuxbrew/.linuxbrew/bin/brew"
BREW_INIT='eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"'

# Install Homebrew if missing
if [ ! -x "$BREW_BIN" ]; then
  echo "Installing Homebrew..."
  NONINTERACTIVE=1 /bin/bash -c \
    "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

# Make Homebrew available to THIS script
eval "$($BREW_BIN shellenv)"

# Persist for future zsh sessions
touch "$HOME/.zprofile"

if ! grep -Fq "$BREW_INIT" "$HOME/.zprofile"; then
  echo "Adding Homebrew to ~/.zprofile"
  echo "$BREW_INIT" >> "$HOME/.zprofile"
fi

export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_INSTALL_UPGRADE=1

# Install Ansible
if ! brew list ansible >/dev/null 2>&1; then
  echo "Installing Ansible..."
  brew install ansible
else
  echo "Ansible is already installed."
fi

echo
echo "Bootstrap complete."
echo
echo "To use brew/ansible in your current shell run:"
echo
echo "    source ~/.zprofile"
echo
echo "or open a new terminal."